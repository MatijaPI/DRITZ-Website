# Copy to `.env` for local builds. In GitHub Actions these are read from repository
# variables (Settings → Secrets and variables → Actions → Variables). None are secret.

# Google Search Console HTML-tag verification token (content of the meta tag only).
# Leave empty if the domain is verified via DNS.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional form endpoint that accepts POSTed form data and returns JSON
# (e.g. https://formspree.io/f/xxxxxxx). Empty = the contact form opens the visitor's e-mail app.
PUBLIC_FORM_ENDPOINT=

# Optional, privacy-friendly analytics (disabled when empty).
# Plausible: PUBLIC_ANALYTICS_PROVIDER=plausible, PUBLIC_ANALYTICS_DOMAIN=dritz.si
# Umami:     PUBLIC_ANALYTICS_PROVIDER=umami, PUBLIC_ANALYTICS_SRC=https://.../script.js, PUBLIC_ANALYTICS_ID=<website-id>
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_ID=
