---
/**
 * Infinite logo strip. CSS-only; pauses on hover/focus and with the global
 * pause control; becomes a static wrapped row with reduced motion.
 * The duplicate set is aria-hidden so screen readers hear each name once.
 */
import { Image } from 'astro:assets';
import { seasons } from '../../data/supporters.ts';
import { t, fmt, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const all = seasons.flatMap((s) => s.supporters);
---

<div class="marquee" data-reveal="fade">
  {[0, 1].map((copy) => (
    <ul role="list" class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
      {all.map((s) => (
        <li class="marquee-item">
          {s.logo ? (
            <span class="logo-chip">
              <Image
                src={s.logo}
                alt={copy === 1 ? '' : fmt(d.supportersPage.logoAlt, { name: s.shortName ?? s.name })}
                width={160}
                height={Math.round((160 * s.logo.height) / s.logo.width)}
                densities={[1, 2]}
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </span>
          ) : (
            <span class="name-chip">{s.name}</span>
          )}
        </li>
      ))}
    </ul>
  ))}
</div>

<style>
  .marquee {
    --gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    display: flex;
    gap: var(--gap);
    overflow: hidden;
    padding-block: var(--space-s);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--gap);
    min-width: 100%;
    justify-content: space-around;
    padding: 0;
    list-style: none;
  }

  .logo-chip,
  .name-chip {
    display: grid;
    place-items: center;
    height: 6rem;
    border-radius: var(--radius-m);
  }

  .logo-chip {
    width: 10rem;
    padding: 0.75rem 1.25rem;
    background: var(--paper-50);
    box-shadow: var(--shadow-s);
  }

  .logo-chip :global(img) {
    max-height: 4.25rem;
    width: auto;
    object-fit: contain;
  }

  .name-chip {
    padding-inline: 1.5rem;
    border: 1px dashed var(--border-strong);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 32s linear infinite;
    }

    .marquee:hover .marquee-track,
    .marquee:focus-within .marquee-track,
    :global([data-motion='paused']) .marquee-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      flex-wrap: wrap;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .marquee-track {
      flex-wrap: wrap;
      justify-content: center;
    }

    .marquee-track[aria-hidden] {
      display: none;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }
</style>
