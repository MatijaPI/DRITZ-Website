---
/** "What does DRITZ stand for?" — each row pairs a logo icon-letter with its word. */
import Logo from '../ui/Logo.astro';
import { t, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).brand;

const highlight = (word: string, letter: string) => {
  const i = word.indexOf(letter);
  return i < 0 ? { before: word, mark: '', after: '' } : { before: word.slice(0, i), mark: letter, after: word.slice(i + 1) };
};
---

<figure class="acronym">
  <figcaption class="mono acronym-label">{d.acronymLabel}</figcaption>
  <ol role="list" class="acronym-list" data-stagger>
    {d.acronym.map((row, i) => {
      const w = highlight(row.word, row.letter);
      return (
        <li class="acronym-row" data-reveal>
          <span class="acronym-glyph" aria-hidden="true">
            <Logo letter={i as 0 | 1 | 2 | 3 | 4} />
          </span>
          <span class="acronym-text">
            <span class="acronym-word" lang="sl">
              {w.before}
              <mark>{w.mark}</mark>
              {w.after}
            </span>
            <span class="acronym-note">{row.note}</span>
          </span>
        </li>
      );
    })}
  </ol>
</figure>

<style>
  .acronym {
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    padding: var(--space-m);
  }

  .acronym-label {
    margin-bottom: var(--space-s);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .acronym-list {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .acronym-row {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: var(--space-s);
    align-items: center;
    padding-block: 0.7rem;
    border-top: 1px solid var(--border);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .acronym-row:first-child {
    border-top: 0;
  }

  .acronym-glyph {
    display: grid;
    place-items: center;
    height: 3rem;
    color: var(--logo-ink);
    transition:
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }

  .acronym-glyph :global(svg) {
    height: 100%;
    width: auto;
    max-width: 100%;
  }

  .acronym-row:hover .acronym-glyph {
    color: var(--accent-text);
    transform: scale(1.08) rotate(-3deg);
  }

  .acronym-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .acronym-word {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
  }

  mark {
    background: none;
    color: var(--accent-text);
  }

  .acronym-note {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
