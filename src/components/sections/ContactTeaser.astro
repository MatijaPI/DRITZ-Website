---
import Icon from '../ui/Icon.astro';
import SplitText from '../ui/SplitText.astro';
import { site } from '../../data/site.ts';
import { t, path, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<section class="section contact-teaser" id="kontakt" aria-labelledby="contact-teaser-title">
  <div class="container contact-grid">
    <div class="contact-intro">
      <p class="eyebrow">{d.home.contact.eyebrow}</p>
      <SplitText text={d.home.contact.title} id="contact-teaser-title" class="display" />
      <p class="lead" data-reveal>
        {d.home.contact.body}
      </p>
    </div>
    <div class="contact-links" data-stagger>
      <a class="contact-big" href={`mailto:${site.email}`} data-reveal data-cursor="hover">
        <span class="mono label">{d.contactPage.details.email}</span>
        <span class="value">{site.email}</span>
        <Icon name="arrow" class="go" />
      </a>
      <a class="contact-big" href={site.phone.href} data-reveal data-cursor="hover">
        <span class="mono label">{d.contactPage.details.phone}</span>
        <span class="value">{locale === 'sl' ? site.phone.display : site.phone.international}</span>
        <Icon name="arrow" class="go" />
      </a>
      <div class="contact-big contact-static" data-reveal>
        <span class="mono label">{d.contactPage.details.address}</span>
        <span class="value value--small">
          {site.address.street}, {site.address.postalCode} {site.address.city}
        </span>
      </div>
      <a class="btn btn--primary contact-cta" href={path('contact', locale)} data-reveal data-magnetic>
        {d.home.contact.link}
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .contact-intro {
    display: grid;
    gap: var(--space-m);
  }

  .contact-links {
    display: grid;
    gap: 0;
  }

  .contact-big {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem var(--space-s);
    align-items: center;
    padding-block: var(--space-m);
    border-top: 1px solid var(--border);
    text-decoration: none;
  }

  .contact-big:last-of-type {
    border-bottom: 1px solid var(--border);
  }

  .label {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    transition: color var(--dur-base) var(--ease-out);
  }

  .value--small {
    font-size: var(--step-1);
  }

  a.contact-big:hover .value {
    color: var(--accent-text);
  }

  .contact-big :global(.go) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--accent-text);
    transform: rotate(-45deg);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .contact-big:hover :global(.go) {
    transform: rotate(0);
  }

  .contact-cta {
    margin-top: var(--space-l);
    justify-self: start;
  }

  @media (min-width: 60em) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
