---
import Icon from '../ui/Icon.astro';
import logoVerticalUrl from '../../assets/brand/logo-vertical.svg?url';
import { t, path, type Locale } from '../../i18n/index.ts';
import { activeMotto } from '../../i18n/motto.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const motto = activeMotto()[locale];
const cycle = motto.cycle ?? [];
// Split the motto so the last word can be animated (only when a cycle is defined).
const lastWord = cycle[0];
const head = lastWord && motto.text.includes(lastWord) ? motto.text.slice(0, motto.text.lastIndexOf(lastWord)) : motto.text;
const tail =
  lastWord && motto.text.includes(lastWord) ? motto.text.slice(motto.text.lastIndexOf(lastWord) + lastWord.length) : '';
// The longest alternative reserves the space (via a CSS pseudo-element, so it is not page text).
const ghost = cycle.reduce((a, b) => (b.length > a.length ? b : a), '') + tail;
---

<section class="hero" id="drustvo" aria-labelledby="hero-title">
  <div class="hero-bg blueprint" aria-hidden="true"></div>
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">{d.home.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero-title" data-cycle={cycle.join('|')}>
        <span class="hero-line">{head.trim()}</span>{' '}
        {lastWord ? (
          <span class="hero-line hero-accent">
            <span class="cycle" data-ghost={ghost}>
              <span class="cycle-live">
                <span data-cycle-word>{lastWord}</span>
                {tail}
              </span>
            </span>
          </span>
        ) : null}
      </h1>
      <p class="lead hero-lead">{d.home.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={path('join', locale)} data-magnetic>
          {d.home.hero.primary}
          <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost" href={path('activities', locale)} data-magnetic>
          {d.home.hero.secondary}
        </a>
      </div>
    </div>

    <div class="hero-side" aria-hidden="true">
      <div class="hero-logo">
        <svg viewBox="375 74 534 1379" fill="currentColor" focusable="false">
          <use href={`${logoVerticalUrl}#dritz`}></use>
        </svg>
      </div>
    </div>

    <dl class="hero-console mono" aria-label={d.home.hero.consoleLabel}>
      {d.home.hero.console.map((row) => (
        <div>
          <dt>{row.key}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="container hero-foot">
    <a href="#o-drustvu" class="scroll-hint mono">
      <span class="scroll-line" aria-hidden="true"></span>
      {d.a11y.scrollHint}
    </a>
    <button
      type="button"
      class="motion-toggle mono"
      data-motion-toggle
      aria-pressed="false"
      aria-label={d.motion.pause}
      data-label-pause={d.motion.pause}
      data-label-play={d.motion.play}
    >
      <span class="mt-pause" aria-hidden="true">
        ❚❚
      </span>
      <span class="mt-play" aria-hidden="true">
        ▶
      </span>
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--space-xl) var(--space-l);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg,
  .hero-canvas,
  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-bg {
    mask-image: radial-gradient(ellipse 90% 80% at 65% 40%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 65% 40%, #000 30%, transparent 85%);
  }

  .hero-canvas {
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }

  .hero-canvas:global(.is-ready) {
    opacity: 1;
  }

  .hero-vignette {
    background:
      radial-gradient(ellipse 60% 50% at 80% 30%, var(--glow-accent), transparent 70%),
      radial-gradient(ellipse 50% 40% at 10% 90%, var(--glow-go), transparent 70%),
      linear-gradient(90deg, var(--bg) 0%, transparent 55%);
    opacity: 0.5;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-m);
    max-width: 48rem;
  }

  .hero-title {
    font-size: clamp(2.15rem, 9.4vw, 5.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    text-wrap: initial;
  }

  .hero-line {
    display: block;
  }

  .hero-accent {
    color: var(--accent-text);
  }

  /* All cycle words are stacked in one grid cell so the box never changes size (CLS 0). */
  .cycle {
    display: inline-grid;
    max-width: 100%;
  }

  .cycle > *,
  .cycle::before {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .cycle::before {
    content: attr(data-ghost);
    visibility: hidden;
    padding-right: 0.15em;
  }

  [data-cycle-word]::after {
    content: '';
    display: inline-block;
    width: 0.07em;
    height: 0.8em;
    margin-left: 0.06em;
    background: currentColor;
    vertical-align: -0.04em;
    animation: caret 1.05s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .hero-lead {
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
  }

  .hero-side {
    display: none;
  }

  .hero-logo {
    color: var(--logo-ink);
    filter: drop-shadow(0 0 30px var(--glow-accent));
  }

  .hero-logo svg {
    height: min(62svh, 34rem);
    width: auto;
    margin-inline: auto;
  }

  .hero-console {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--border);
    overflow: hidden;
    font-size: 0.75rem;
  }

  .hero-console > div {
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero-console dt {
    color: var(--text-subtle);
    letter-spacing: var(--tracking-mono);
  }

  .hero-console dd {
    color: var(--text);
    font-weight: 500;
  }

  .hero-console > div:last-child dd {
    color: var(--go-text);
  }

  .hero-console > div:last-child dd::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.45em;
    border-radius: 50%;
    background: var(--go);
    box-shadow: 0 0 10px var(--go);
    animation: pulse-dot 2s var(--ease-in-out) infinite;
  }

  @keyframes pulse-dot {
    50% {
      opacity: 0.35;
    }
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-xl);
  }

  .scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-subtle);
    text-decoration: none;
  }

  .scroll-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--border-strong);
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: scroll-line 2.2s var(--ease-in-out) infinite;
  }

  @keyframes scroll-line {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  .motion-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .motion-toggle:hover {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .mt-play,
  :global([data-motion='paused']) .mt-pause {
    display: none;
  }

  :global([data-motion='paused']) .mt-play {
    display: inline;
  }

  :global([data-motion='paused']) .hero :is(.scroll-line::after, [data-cycle-word]::after) {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-toggle {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-eyebrow,
    .hero-lead,
    .hero-actions,
    .hero-console,
    .hero-logo {
      animation: rise 1s var(--ease-out) both;
    }

    .hero-line {
      animation: line-in 1.1s var(--ease-out) both;
      clip-path: inset(0 0 -0.2em 0);
    }

    .hero-line + .hero-line {
      animation-delay: 120ms;
    }

    .hero-lead {
      animation-delay: 300ms;
    }

    .hero-actions {
      animation-delay: 420ms;
    }

    .hero-console {
      animation-delay: 560ms;
    }

    .hero-logo {
      animation:
        logo-in 1.6s var(--ease-out) 200ms both,
        float 7s var(--ease-in-out) 1.8s infinite;
    }

    :global([data-motion='paused']) .hero-logo {
      animation-play-state: paused;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes line-in {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }

  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.96);
      filter: blur(8px) drop-shadow(0 0 0 transparent);
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-12px);
    }
  }

  @media (min-width: 64em) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'copy side'
        'console side';
      column-gap: var(--space-2xl);
    }

    .hero-copy {
      grid-area: copy;
    }

    .hero-side {
      grid-area: side;
      display: block;
    }

    .hero-console {
      grid-area: console;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 48rem;
    }
  }
</style>
