---
/**
 * Animated robot-arm illustration drawn in the logo's line style (pure SVG + CSS).
 * Decorative: aria-hidden. Static with reduced motion or the global pause.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['robot-arm', className]} viewBox="0 0 320 320" fill="none" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M60 290h200" />
    <rect x="95" y="260" width="130" height="30" rx="8" />
    <path d="M120 260v-12h80v12" />
    <g class="arm-base">
      <circle cx="160" cy="236" r="18" />
      <circle cx="160" cy="236" r="6" class="accent-fill" />
      <g class="arm-lower">
        <rect x="150" y="130" width="20" height="104" rx="10" />
        <circle cx="160" cy="130" r="15" />
        <path d="M156 160h8M156 176h8M156 192h8" class="accent-stroke" />
        <g class="arm-upper">
          <rect x="160" y="120" width="96" height="20" rx="10" />
          <circle cx="256" cy="130" r="12" />
          <g class="gripper">
            <path d="M256 142v14" />
            <path d="M244 156h24" />
            <path class="claw-l" d="M246 156l-8 18 6 8" />
            <path class="claw-r" d="M266 156l8 18-6 8" />
          </g>
        </g>
      </g>
    </g>
    <g transform="translate(70 70)">
      <g class="gear">
        <circle r="16" />
        <circle r="5" class="accent-fill" />
        <path d="M0-26v8M0 18v8M-26 0h8M18 0h8M-18.4-18.4l5.7 5.7M12.7 12.7l5.7 5.7M-18.4 18.4l5.7-5.7M12.7-12.7l5.7-5.7" />
      </g>
    </g>
    <g transform="translate(262 196)">
      <g class="spark">
        <path d="M0-12v6M0 6v6M-12 0h6M6 0h6" class="accent-stroke" />
      </g>
    </g>
  </g>
</svg>

<style>
  .robot-arm {
    color: var(--logo-ink);
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .accent-fill {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .accent-stroke {
    stroke: var(--accent);
  }

  .arm-lower,
  .arm-upper,
  .claw-l,
  .claw-r {
    transform-box: view-box;
  }

  .gear,
  .spark {
    transform-box: fill-box;
    transform-origin: center;
  }

  .arm-lower {
    transform-origin: 160px 236px;
  }

  .arm-upper {
    transform-origin: 160px 130px;
  }

  .claw-l {
    transform-origin: 246px 156px;
  }

  .claw-r {
    transform-origin: 266px 156px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .arm-lower {
      animation: arm-lower 6s var(--ease-in-out) infinite;
    }

    .arm-upper {
      animation: arm-upper 6s var(--ease-in-out) infinite;
    }

    .claw-l {
      animation: claw-l 6s var(--ease-in-out) infinite;
    }

    .claw-r {
      animation: claw-r 6s var(--ease-in-out) infinite;
    }

    .gear {
      animation: gear 8s linear infinite;
    }

    .spark {
      animation: spark 6s var(--ease-out) infinite;
    }

    :global([data-motion='paused']) .robot-arm * {
      animation-play-state: paused !important;
    }
  }

  @keyframes arm-lower {
    0%,
    100% {
      transform: rotate(-8deg);
    }
    45%,
    60% {
      transform: rotate(10deg);
    }
  }

  @keyframes arm-upper {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    45%,
    60% {
      transform: rotate(22deg);
    }
  }

  @keyframes claw-l {
    0%,
    40%,
    70%,
    100% {
      transform: rotate(0);
    }
    50%,
    62% {
      transform: rotate(14deg);
    }
  }

  @keyframes claw-r {
    0%,
    40%,
    70%,
    100% {
      transform: rotate(0);
    }
    50%,
    62% {
      transform: rotate(-14deg);
    }
  }

  @keyframes gear {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes spark {
    0%,
    48% {
      opacity: 0;
      transform: scale(0.4);
    }
    55% {
      opacity: 1;
      transform: scale(1.2);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>
