---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { t, formatDate, newsPath, type Locale } from '../../i18n/index.ts';
import { entrySlug, type NewsEntry } from '../../lib/news.ts';

interface Props {
  entry: NewsEntry;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}

const { entry, locale, headingLevel: H = 'h3', featured = false } = Astro.props;
const d = t(locale);
const { title, excerpt, date, dateLabel, image, imageAlt, location } = entry.data;
const href = newsPath(locale, entrySlug(entry));
---

<article class:list={['news-card card--bracket', { 'news-card--featured': featured }]} data-reveal>
  <div class="news-media">
    <Picture
      src={image}
      alt={imageAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={featured ? [480, 800, 1200] : [400, 640, 900]}
      width={featured ? 1200 : 900}
      height={Math.round(((featured ? 1200 : 900) * image.height) / image.width)}
      sizes={featured ? '(min-width: 64em) 58vw, 100vw' : '(min-width: 64em) 30vw, (min-width: 40em) 46vw, 100vw'}
      loading={featured ? 'eager' : 'lazy'}
      fetchpriority={featured ? 'high' : 'auto'}
      decoding="async"
      quality={70}
    />
  </div>
  <div class="news-body">
    <p class="news-meta mono">
      {date ? <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, locale)}</time> : <span>{dateLabel}</span>}
      {location && date && <span class="news-loc">· {location}</span>}
    </p>
    <H class="news-title">
      <a href={href} class="stretched-link">
        {title}
      </a>
    </H>
    <p class="news-excerpt">{excerpt}</p>
    <span class="link-arrow" aria-hidden="true">
      {d.cta.readMore}
      <Icon name="arrow" />
    </span>
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .news-card:hover {
    transform: translateY(-4px);
  }

  .news-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-strong);
  }

  .news-media :global(picture) {
    height: 100%;
  }

  .news-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 900ms var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
    filter: saturate(0.9);
  }

  .news-card:hover .news-media :global(img),
  .news-card:focus-within .news-media :global(img) {
    transform: scale(1.06);
    filter: saturate(1.1);
  }

  .news-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(5 7 13 / 0.45));
    pointer-events: none;
  }

  .news-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    padding: var(--space-m) var(--space-m) var(--space-l);
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    font-size: 0.8125rem;
    color: var(--accent-text);
  }

  .news-loc {
    color: var(--text-subtle);
  }

  .news-title {
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .news-title a {
    text-decoration: none;
  }

  .news-title a:focus-visible {
    outline: none;
  }

  .news-card:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .news-excerpt {
    color: var(--text-muted);
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .link-arrow {
    margin-top: auto;
    padding-top: var(--space-xs);
    align-self: flex-start;
  }

  .news-card:hover .link-arrow {
    background-size: 100% 1px;
  }

  @media (min-width: 64em) {
    .news-card--featured {
      flex-direction: row;
      grid-column: 1 / -1;
    }

    .news-card--featured .news-media {
      flex: 0 0 58%;
      aspect-ratio: auto;
      min-height: 22rem;
    }

    .news-card--featured .news-body {
      justify-content: center;
      padding: var(--space-xl);
    }

    .news-card--featured .news-title {
      font-size: var(--step-3);
    }
  }
</style>
