---
/**
 * Non-intrusive language suggestion. Rendered hidden; JS reveals it only when the
 * browser language differs from the page language, no preference is stored and
 * it has not been dismissed. Its text is in the *suggested* language.
 */
import Icon from '../ui/Icon.astro';
import { t, localeMeta, otherLocale, path, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const target = otherLocale(locale);
const d = t(target);
const href = alternates[target] ?? path('home', target);
---

<aside
  class="lang-banner"
  data-lang-banner
  data-target-lang={target}
  lang={localeMeta[target].htmlLang}
  hidden
  aria-label={d.langBanner.text}
>
  <div class="container lang-banner-inner">
    <p>{d.langBanner.text}</p>
    <div class="lang-banner-actions">
      <a class="btn btn--primary btn--small" href={href} hreflang={localeMeta[target].htmlLang} data-set-lang={target}>
        {d.langBanner.action}
      </a>
      <button type="button" class="icon-btn" data-lang-dismiss aria-label={d.langBanner.dismiss}>
        <Icon name="close" size={18} />
      </button>
    </div>
  </div>
</aside>

<style>
  .lang-banner {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: var(--z-banner);
    width: min(100% - 2rem, 40rem);
    transform: translateX(-50%);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    background: var(--surface-strong);
    box-shadow: var(--shadow-l);
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-banner:not([hidden]) {
      animation: banner-in 600ms var(--ease-out) both;
    }
  }

  @keyframes banner-in {
    from {
      opacity: 0;
      transform: translate(-50%, 20px);
    }
  }

  .lang-banner-inner {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .lang-banner p {
    font-size: 0.9375rem;
  }

  .lang-banner-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn--small {
    min-height: 2.5rem;
    padding: 0.5em 1.1em;
    font-size: 0.875rem;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
</style>
