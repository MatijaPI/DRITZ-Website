---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import Acronym from '../sections/Acronym.astro';
import Manifesto from '../sections/Manifesto.astro';
import Values from '../sections/Values.astro';
import Timeline from '../sections/Timeline.astro';
import CtaBand from '../sections/CtaBand.astro';
import workshopRobot from '../../assets/images/fll-delavnica-robot.jpg';
import workshopTable from '../../assets/images/fll-delavnica.jpg';
import { site } from '../../data/site.ts';
import { t, routes, path, type Locale } from '../../i18n/index.ts';
import { ogImagePath } from '../../lib/seo.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const a = d.about;
const rows = [
  { k: a.legal.rows.legalName, v: site.legalName },
  { k: a.legal.rows.shortName, v: site.name },
  { k: a.legal.rows.seat, v: `${site.address.street}, ${site.address.postalCode} ${site.address.city}` },
  { k: a.legal.rows.since, v: String(site.foundingYear) },
];
const imgAlt = a.imageAlts;
---

<BaseLayout
  locale={locale}
  title={a.meta.title}
  description={a.meta.description}
  alternates={routes.about}
  ogImage={ogImagePath(locale, 'about')}
  pageType="AboutPage"
  breadcrumbs={[
    { name: d.breadcrumbs.home, path: path('home', locale) },
    { name: d.nav.about, path: path('about', locale) },
  ]}
>
  <PageHero eyebrow={a.hero.eyebrow} title={a.hero.title} lead={a.hero.lead} />

  <section class="section section--tight" aria-labelledby="story-title">
    <div class="container story">
      <div class="story-copy">
        <h2 id="story-title" class="h2">
          {a.story.title}
        </h2>
        {a.story.paragraphs.map((p) => (
          <p data-reveal>{p}</p>
        ))}
        <figure class="heritage" data-reveal>
          <blockquote>{a.story.heritage}</blockquote>
          <figcaption class="mono">{a.story.heritageLabel}</figcaption>
        </figure>
      </div>
      <div class="story-media">
        <div class="img-frame tall" data-reveal-image>
          <Picture
            src={workshopRobot}
            alt={imgAlt[0]!}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 800, 1100]}
            width={1100}
            height={825}
            sizes="(min-width: 60em) 40vw, 100vw"
            quality={68}
            loading="lazy"
          />
        </div>
        <div class="img-frame" data-reveal-image>
          <Picture
            src={workshopTable}
            alt={imgAlt[1]!}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 800]}
            width={800}
            height={600}
            sizes="(min-width: 60em) 28vw, 100vw"
            quality={68}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label={`${a.mission.title} · ${a.vision.title}`}>
    <div class="container mv" data-stagger>
      <article class="mv-card card" data-reveal>
        <p class="eyebrow">{a.mission.title}</p>
        <p class="mv-text">{a.mission.text}</p>
      </article>
      <article class="mv-card card" data-reveal>
        <p class="eyebrow">{a.vision.title}</p>
        <p class="mv-text">{a.vision.text}</p>
      </article>
    </div>
  </section>

  <Manifesto locale={locale} eyebrow={d.home.manifesto.eyebrow} />
  <Values locale={locale} />

  <section class="section" aria-labelledby="journey-title">
    <div class="container">
      <SectionHead eyebrow={d.home.timeline.eyebrow.replace(/^\d+ \/\/ /, '')} title={d.home.timeline.title} id="journey-title" />
      <Timeline locale={locale} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="team-title">
    <div class="container team">
      <div class="team-copy">
        <h2 id="team-title" class="h2">
          {a.team.title}
        </h2>
        <p class="lead">{a.team.text}</p>
        <a class="btn btn--primary" href={`${path('contact', locale)}?topic=volunteer`} data-magnetic>
          {a.team.link}
          <Icon name="arrow" />
        </a>
      </div>
      <Acronym locale={locale} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="legal-title">
    <div class="container">
      <h2 id="legal-title" class="h3 legal-title">
        {a.legal.title}
      </h2>
      <dl class="legal">
        {rows.map((r) => (
          <div>
            <dt class="mono">{r.k}</dt>
            <dd>{r.v}</dd>
          </div>
        ))}
        <div>
          <dt class="mono">{a.legal.rows.email}</dt>
          <dd>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
        <div>
          <dt class="mono">{a.legal.rows.phone}</dt>
          <dd>
            <a href={site.phone.href}>{locale === 'sl' ? site.phone.display : site.phone.international}</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .story-copy {
    display: grid;
    gap: var(--space-m);
  }

  .story-copy p {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .heritage {
    margin-top: var(--space-s);
    padding-left: var(--space-m);
    border-left: 3px solid var(--accent);
  }

  .heritage blockquote {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }

  .heritage figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }

  .story-media {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-s);
    align-items: end;
  }

  .img-frame {
    overflow: hidden;
    border-radius: var(--radius-l);
    aspect-ratio: 4 / 3;
    background: var(--surface-strong);
  }

  .img-frame.tall {
    aspect-ratio: 3 / 4;
  }

  .img-frame :global(picture) {
    height: 100%;
  }

  .img-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mv {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .mv-card {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-xl);
  }

  .mv-text {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.3;
  }

  .team {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .team-copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .legal-title {
    margin-bottom: var(--space-m);
  }

  .legal {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .legal > div {
    display: grid;
    gap: 0.25rem var(--space-m);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--border);
  }

  .legal dt {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
  }

  .legal a {
    color: var(--accent-text);
  }

  @media (min-width: 48em) {
    .legal > div {
      grid-template-columns: 14rem 1fr;
    }
  }

  @media (min-width: 60em) {
    .story,
    .team {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
