---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import { t, routes, path, formatDate, type Locale } from '../../i18n/index.ts';
import { ogImagePath } from '../../lib/seo.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const [entry] = await getCollection('legal', (e) => e.id.startsWith(`${locale}/`) && e.data.translationKey === 'privacy');
if (!entry) throw new Error(`Privacy policy for "${locale}" is missing in src/content/legal/${locale}/`);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  alternates={routes.privacy}
  ogImage={ogImagePath(locale, 'privacy')}
  breadcrumbs={[
    { name: d.breadcrumbs.home, path: path('home', locale) },
    { name: entry.data.title, path: path('privacy', locale) },
  ]}
>
  <PageHero eyebrow={d.privacyPage.eyebrow} title={entry.data.title}>
    <p class="mono updated">
      {d.privacyPage.updated}:{' '}
      <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{formatDate(entry.data.updated, locale)}</time>
    </p>
  </PageHero>
  <div class="container--narrow prose legal-body">
    <Content />
  </div>
</BaseLayout>

<style>
  .updated {
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }

  .legal-body {
    padding-bottom: var(--space-2xl);
  }
</style>
